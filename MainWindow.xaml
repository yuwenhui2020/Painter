                                            <!-- 第八行：物理波形/电磁图元（拖拽绘制，mode 37~42） -->
                                            <ui:SimpleStackPanel Height="50" Spacing="10" Orientation="Horizontal">
                                                <Image Margin="16,10,2,10" Width="30" MouseUp="BtnDrawSineWave_Click" ToolTip="正弦波形（交流信号）" Source="{DynamicResource DrawShapeImageSource.SineWave}"/>
                                                <Image Margin="0,10,2,10" Width="30" MouseUp="BtnDrawPositiveCharge_Click" ToolTip="正点电荷 ⊕" Source="{DynamicResource DrawShapeImageSource.PositiveCharge}"/>
                                                <Image Margin="0,10,2,10" Width="30" MouseUp="BtnDrawNegativeCharge_Click" ToolTip="负点电荷 ⊖" Source="{DynamicResource DrawShapeImageSource.NegativeCharge}"/>
                                                <Image Margin="0,10,2,10" Width="30" MouseUp="BtnDrawMagneticFieldOut_Click" ToolTip="均匀磁场向外：拖拽画区域，整齐铺满圆点，数量随区域大小变化" Source="{DynamicResource DrawShapeImageSource.MagneticFieldOut}"/>
                                                <Image Margin="0,10,2,10" Width="30" MouseUp="BtnDrawMagneticFieldIn_Click" ToolTip="均匀磁场向里：拖拽画区域，整齐铺满叉号，数量随区域大小变化" Source="{DynamicResource DrawShapeImageSource.MagneticFieldIn}"/>
                                            </ui:SimpleStackPanel>
                                        </ui:SimpleStackPanel>
                                    </Viewbox>
                                </Border>
                            </Grid>
                            <local:AppIcon Glyph="Undo" Foreground="{DynamicResource FloatBarForeground}" Margin="0,0,-2,0"
                                           Opacity="{Binding ElementName=BtnUndo, Path=IsEnabled, Converter={StaticResource IsEnabledToOpacityConverter}}"
                                           IsEnabled="{Binding ElementName=BtnUndo, Path=IsEnabled}"
                                           MouseUp="SymbolIconUndo_MouseUp" MouseDown="Border_MouseDown"/>
                            <local:AppIcon Glyph="Redo" Foreground="{DynamicResource FloatBarForeground}" Margin="-2,0,0,0"
                                           Opacity="{Binding ElementName=BtnRedo, Path=IsEnabled, Converter={StaticResource IsEnabledToOpacityConverter}}"
                                           IsEnabled="{Binding ElementName=BtnRedo, Path=IsEnabled}"
                                           MouseUp="SymbolIconRedo_MouseUp" MouseDown="Border_MouseDown"/>
                            <local:AppIcon x:Name="LockSmithSymbol" 
                                           Glyph="Pin" Foreground="{DynamicResource FloatBarForeground}" Margin="-2,0,0,0"
                                           MouseUp="SymbolIconPin_MouseUp" MouseDown="Border_MouseDown"/>
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Orientation="{Binding ElementName=StackPanelFloatingBar, Path=Orientation}">
                            <Grid Width="20" Height="24" Margin="2,0,12,1">
                                <Image Margin="-8" MouseDown="Border_MouseDown" MouseUp="ImageBlackboard_MouseUp">
                                    <Image.Source>
                                        <DrawingImage>
                                            <DrawingImage.Drawing>
                                                <DrawingGroup ClipGeometry="M0,0 V64 H64 V0 H0 Z">
                                                    <DrawingGroup Opacity="1">
                                                        <GeometryDrawing Brush="{DynamicResource FloatBarForeground}" Geometry="F1 M64,64z M0,0z M15.125,48.875L15.125,17.375 21.875,17.375 21.875,15.125 24.125,15.125 24.125,17.375 39.875,17.375 39.875,15.125 42.125,15.125 42.125,17.375 48.875,17.375 48.875,48.875 M46.625,46.625L46.625,26.375 17.375,26.375 17.375,46.625 M17.375,24.125L46.625,24.125 46.625,19.625 42.125,19.625 42.125,21.875 39.875,21.875 39.875,19.625 24.125,19.625 24.125,21.875 21.875,21.875 21.875,19.625 17.375,19.625 17.375,24.125z" />
                                                    </DrawingGroup>
                                                </DrawingGroup>
                                            </DrawingImage.Drawing>
                                        </DrawingImage>
                                    </Image.Source>
                                </Image>
                            </Grid>
                            <Grid Margin="0,5,0,5" Visibility="{Binding ElementName=StackPanelPPTButtons, Path=Visibility}">
                                <Image Source="{DynamicResource ResourceKey=SeewoImageSource.PPTExitNormal}" Visibility="{Binding ElementName=BtnPPTSlideShowEnd, Path=Visibility}" MouseDown="Border_MouseDown" MouseUp="ImagePPTControlEnd_MouseUp" Margin="-2,1,10,2"/>
                            </Grid>
                            <ui:SimpleStackPanel Margin="0,5,10,5" Spacing="10" Orientation="{Binding ElementName=StackPanelFloatingBar, Path=Orientation}">
                                <Grid Height="24" Width="20" Name="GridWrench">
                                    <local:AppIcon Glyph="Repair" Foreground="{DynamicResource FloatBarForeground}" MouseDown="Border_MouseDown" MouseUp="SymbolIconTools_MouseUp"/>
                                </Grid>
                                <Popup Name="PopupTools" PlacementTarget="{Binding ElementName=GridWrench}" Placement="Top" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="37">
                                    <Border Width="215" CornerRadius="8" Background="{DynamicResource FloatBarBackground}" BorderThickness="1" BorderBrush="{DynamicResource FloatBarBorderBrush}"
                                            Padding="12,10,12,12">
                                        <ui:SimpleStackPanel Spacing="10">
                                            <Label Content="快捷设置" FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Margin="0,0,0,2"/>
                                            <ui:SimpleStackPanel>
                                                <Label Margin="0,0,0,-4" Content="画笔粗细" Foreground="{DynamicResource FloatBarForeground}" FontSize="13"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Slider HorizontalAlignment="Left" Minimum="1" Maximum="20" Width="110"
                                                            IsSnapToTickEnabled="True" Value="{Binding Source={x:Reference InkWidthSlider}, Path=Value, Mode=TwoWay}"
                                                            TickFrequency="1" TickPlacement="Both"/>
                                                    <TextBlock Text="{Binding Value, Source={x:Reference InkWidthSlider}, Mode=OneWay}"
                                                               Foreground="{DynamicResource FloatBarForeground}"
                                                               VerticalAlignment="Bottom" Margin="8,0,0,6" Width="16" FontSize="13"/>
                                                </StackPanel>
                                            </ui:SimpleStackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <ui:SimpleStackPanel Margin="0,0,18,0">
                                                    <Label Margin="0,0,0,-4" Content="墨迹识别" Foreground="{DynamicResource FloatBarForeground}" FontSize="13"/>
                                                    <ui:ToggleSwitch Foreground="{DynamicResource FloatBarForeground}" FontFamily="{DynamicResource AppFontFamily}" Width="72" MinWidth="0" OnContent="开" OffContent="关" Toggled="ToggleSwitchEnableInkToShape_Toggled" IsOn="{Binding Source={x:Reference ToggleSwitchEnableInkToShape}, Path=IsOn}"/>
                                                </ui:SimpleStackPanel>
                                                <ui:SimpleStackPanel>
                                                    <Label Margin="0,0,0,-4" Content="手指模式" Foreground="{DynamicResource FloatBarForeground}" FontSize="13"/>
                                                    <ui:ToggleSwitch Foreground="{DynamicResource FloatBarForeground}" IsOn="{Binding Source={x:Reference ToggleSwitchModeFinger}, Path=IsOn}" FontFamily="{DynamicResource AppFontFamily}" OnContent="开" OffContent="关" MinWidth="0" Width="72"/>
                                                </ui:SimpleStackPanel>
                                            </StackPanel>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="14">
                                                <Grid MouseDown="Border_MouseDown" MouseUp="GridInkReplayButton_MouseUp">
                                                    <local:AppIcon Glyph="Edit" Foreground="{DynamicResource FloatBarForeground}"/>
                                                    <Image Source="{DynamicResource AndroidRefreshDrawingImage}" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                           Margin="0,0,-3,-3" Width="11"/>
                                                </Grid>
                                                <local:AppIcon Glyph="Shuffle" Foreground="{DynamicResource FloatBarForeground}" MouseDown="Border_MouseDown" MouseUp="SymbolIconRand_MouseUp"/>
                                                <Grid MouseUp="SymbolIconRandOne_MouseUp" MouseDown="Border_MouseDown">
                                                    <local:AppIcon Glyph="Shuffle" Foreground="{DynamicResource FloatBarForeground}"/>
                                                    <Border CornerRadius="50" BorderBrush="{DynamicResource FloatBarForeground}" BorderThickness="1"
                                                            HorizontalAlignment="Center" Margin="-2,0,0,-2" VerticalAlignment="Bottom" Height="9" Width="9">
                                                        <TextBlock Text="1" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-0.8,0,0" Foreground="{DynamicResource FloatBarForeground}"/>
                                                    </Border>
                                                </Grid>
                                            </ui:SimpleStackPanel>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="14">
                                                <local:AppIcon Glyph="Camera" Foreground="{DynamicResource FloatBarForeground}" MouseDown="Border_MouseDown" MouseUp="SymbolIconScreenshot_MouseUp" ToolTip="截屏"/>
                                                <local:AppIcon Glyph="Setting" Foreground="{DynamicResource FloatBarForeground}" MouseDown="Border_MouseDown" MouseUp="SymbolIconSettings_Click" ToolTip="设置"/>
                                            </ui:SimpleStackPanel>

                                            <!-- Web 控制台：底部常驻显示本机 IP 与端口，方便用户照着在手机/其它电脑浏览器打开 -->
                                            <Border Margin="0,2,0,0" Padding="0,9,0,0"
                                                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource FloatBarBorderBrush}">
                                                <ui:SimpleStackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Web 控制台" FontSize="11" Opacity="0.65"
                                                                   Foreground="{DynamicResource FloatBarForeground}"/>
                                                        <TextBlock Loaded="WebInfoState_Loaded" Margin="8,0,0,0" FontSize="11"
                                                                   Foreground="{DynamicResource FloatBarForeground}"/>
                                                    </StackPanel>
                                                    <!-- Web 控制台默认不启动，必须在这里手动打开 -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="启用服务" FontSize="11" Opacity="0.65" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FloatBarForeground}"/>
                                                        <ui:ToggleSwitch x:Name="WebConsoleSwitch" Margin="8,0,0,0" Width="72" MinWidth="0"
                                                                         FontSize="11" OnContent="开" OffContent="关"
                                                                         Foreground="{DynamicResource FloatBarForeground}"
                                                                         FontFamily="{DynamicResource AppFontFamily}"
                                                                         Loaded="WebConsoleSwitch_Loaded" Toggled="WebConsoleSwitch_Toggled"
                                                                         ToolTip="打开后即可用手机 / 其它电脑访问本机 Web 控制台"/>
                                                    </StackPanel>
                                                    <!-- 所有可用 IPv4 地址逐条显示，点击即在浏览器打开验证 -->
                                                    <StackPanel x:Name="WebInfoUrlPanel" Loaded="WebInfoUrl_Loaded"
                                                                ToolTip="点击地址用浏览器打开验证">
                                                        <TextBlock Text="读取中…" FontSize="12"
                                                                   Foreground="{DynamicResource FloatBarForeground}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="局域网无法访问？点击重新放行防火墙" FontSize="10"
                                                               TextWrapping="Wrap" Opacity="0.7"
                                                               Foreground="{DynamicResource FloatBarForeground}"
                                                               TextDecorations="Underline" Cursor="Hand"
                                                               ToolTip="以管理员身份重新注册 URL ACL 与入站规则"
                                                               MouseUp="WebInfoFirewall_MouseUp"/>
                                                </ui:SimpleStackPanel>
                                            </Border>

                                            <!-- 退出程序：整包退出（画板 + 远控 + 托盘），复用主退出逻辑 -->
                                            <Border Margin="0,2,0,0" Padding="0,9,0,0"
                                                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource FloatBarBorderBrush}">
                                                <Button Content="退出程序" Click="BtnExit_Click"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                                                        ToolTip="退出整个程序（画板 + 远控 + 托盘）"/>
                                            </Border>
                                        </ui:SimpleStackPanel>
                                    </Border>
                                </Popup>
                            </ui:SimpleStackPanel>
                        </ui:SimpleStackPanel>
                    </ui:SimpleStackPanel>
                </Border>
            </ui:SimpleStackPanel>
        </Viewbox>
        <Grid Name="GridForFloatingBarDraging" Background="#01000000" Visibility="Collapsed"
              MouseMove="SymbolIconEmoji_MouseMove" MouseUp="SymbolIconEmoji_MouseUp"/>
        <InkCanvas Name="PainterCanvasForInkReplay" MouseDown="PainterCanvasForInkReplay_MouseDown" Visibility="Collapsed" EditingMode="None" Background="Transparent"/>

        <!-- PPT 放映缩略图侧栏：点击哪一侧的页码按钮，就在这侧从屏幕顶部到底部显示；
             一行一页、当前页居中、可上下滚动或用滑动条找页，点击缩略图跳转。 -->
        <Grid Name="PptThumbnailOverview" Visibility="Collapsed" Panel.ZIndex="1500">
            <!-- 左侧全高侧栏 -->
            <Border Name="PptThumbPanelLeft" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Width="200" Margin="0,0,0,0" Padding="8"
                    Background="{DynamicResource FloatBarBackground}"
                    BorderBrush="{DynamicResource FloatBarBorderBrush}" BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                        <TextBlock Text="幻灯片 · 点击跳页" FontFamily="{DynamicResource AppFontFamily}" FontSize="13"
                                   Foreground="{DynamicResource FloatBarForeground}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="关闭" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                                Padding="6,2" Background="Transparent" Cursor="Hand"
                                Foreground="{DynamicResource FloatBarForeground}" Click="PptThumbnailOverviewClose_Click"/>
                    </DockPanel>
                    <ScrollViewer Name="PptThumbScrollLeft" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch">
                        <StackPanel x:Name="PptThumbnailWrapPanel" Orientation="Vertical"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!-- 右侧全高侧栏：缩略图另放一个容器，避免与左侧共用导致点击哪侧都搬到同一处 -->
            <Border Name="PptThumbPanelRight" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Width="200" Padding="8"
                    Background="{DynamicResource FloatBarBackground}"
                    BorderBrush="{DynamicResource FloatBarBorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                        <TextBlock Text="幻灯片 · 点击跳页" FontFamily="{DynamicResource AppFontFamily}" FontSize="13"
                                   Foreground="{DynamicResource FloatBarForeground}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="关闭" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                                Padding="6,2" Background="Transparent" Cursor="Hand"
                                Foreground="{DynamicResource FloatBarForeground}" Click="PptThumbnailOverviewClose_Click"/>
                    </DockPanel>
                    <ScrollViewer Name="PptThumbScrollRight" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch">
                        <StackPanel x:Name="PptThumbnailWrapPanelRight" Orientation="Vertical"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
